version: 2.0

task "loops":
  given $log defaults to "found 3 errors and 17 warnings"

  for $i in range 1 to 9 step 2:
    info "Item {$i}"

  for each match result in pattern "[0-9]+" of $log:
    info "Found number: {result}"

task "params":
  accepts $items as list of strings

task "timing":
  capture start_time from now
  info "started at {start_time}s ({now.format('2006-01-02')})"

task "detection":
  if my-fake-tool is available:
    info "tool present"
  else:
    info "tool missing"
